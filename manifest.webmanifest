{
  "id": "./",
  "name": "香港定點雨量預報",
  "short_name": "定點雨量",
  "description": "香港未來兩小時定點雨量預報、附近雨勢比較及雨量雷達 Foundation。",
  "lang": "zh-HK",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["weather", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "顯示目前位置雨量",
      "short_name": "目前位置",
      "description": "啟動後顯示定位權限提示或目前位置預報",
      "url": "./?action=locate",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    { "src": "./screenshots/mobile.png", "sizes": "430x932", "type": "image/png", "form_factor": "narrow", "label": "手機定點雨量預報" },
    { "src": "./screenshots/desktop.png", "sizes": "1440x900", "type": "image/png", "form_factor": "wide", "label": "桌面地圖及定點預報" }
  ]
}
